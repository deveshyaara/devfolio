# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js & build outputs
/.next/
/out/
/build
/dist
*.js.map

# testing & coverage
/coverage
/.nyc_output/
/playwright-report/
/test-results/

# typescript & tool caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.turbo/
.cache/

# environment variables & secrets
.env
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*service-account*.json
*firebase-adminsdk*.json
credentials.json
.secrets/

# logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# deployment & cloud tooling
.vercel
.netlify
.firebase/
.genkit/*

# OS & editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# temporary files
/tmp/
/temp/
*.tmp
*.bak
